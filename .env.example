# Database (required for production)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional schema isolation when sharing a PostgreSQL database
# STAZA_DATABASE_SCHEMA=staza
# DATABASE_URL_UNPOOLED=postgresql://...

# Better Auth (required)
BETTER_AUTH_SECRET=generate-a-long-random-string-here
BETTER_AUTH_URL=https://your-domain.vercel.app

# Optional: Grok / external OAuth broker (app works without these)
# GROK_CLIENT_ID=
# GROK_CLIENT_SECRET=
# GROK_ISSUER=

# Admin uploads (Vercel Blob Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token
# After registering the owner, grant ADMIN with npm run db:admin -- email@example.com
