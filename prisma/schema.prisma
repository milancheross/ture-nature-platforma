generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  HOST
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  DESTINATION
  EXPERIENCE
  BLOG
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  host          HostProfile?
  tours         Tour[]
  content       Content[]
  favorites     Favorite[]
  inquiries     Inquiry[]
  media         Media[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model HostProfile {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  bio       String   @default("")
  phone     String   @default("")
  years     Int      @default(0)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tours     Tour[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String   @unique
  nameEn    String?
  imageKey  String   @default("tara-hike")
  tours     Tour[]
}

model Tour {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  title        String
  subtitle     String            @default("")
  category     String
  location     String
  shortDesc    String
  description  String
  priceRsd     Int               @default(0)
  priceUnit    String            @default("osoba")
  duration     String
  groupSize    String
  difficulty   String
  imageKey     String            @default("tara-hike")
  imageUrl     String?
  galleryUrls  String[]          @default([])
  included     String[]          @default([])
  toBring      String[]          @default([])
  itinerary    Json              @default("[]")
  translation  Json?
  meetingPoint String            @default("")
  featured     Boolean           @default(false)
  status       PublicationStatus @default(DRAFT)
  ownerId      String?
  owner        User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  hostId       String
  host         HostProfile       @relation(fields: [hostId], references: [id])
  destinationId Int
  destination  Destination       @relation(fields: [destinationId], references: [id])
  departures   Departure[]
  reviews      Review[]
  favorites    Favorite[]
  inquiries    Inquiry[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  @@index([status, category, destinationId])
  @@index([ownerId])
}

model Departure {
  id          String   @id @default(cuid())
  tourId      Int
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int
  priceRsd    Int?
  inquiries   Inquiry[]
  @@index([tourId, startsAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  tourId    Int
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  @@index([tourId])
}

model Content {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  type        ContentType
  status      PublicationStatus @default(DRAFT)
  title       String
  subtitle    String            @default("")
  shortDesc   String
  description String
  body        String            @default("")
  category    String            @default("")
  region      String            @default("")
  location    String            @default("")
  imageUrl    String?
  galleryUrls String[]          @default([])
  translation Json?
  authorId    String
  author      User              @relation(fields: [authorId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([status, type])
}

model Favorite {
  userId    String
  tourId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, tourId])
}

model Inquiry {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId      Int
  tour        Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  departureId String?
  departure   Departure? @relation(fields: [departureId], references: [id], onDelete: SetNull)
  participants Int
  message     String
  createdAt   DateTime   @default(now())
  @@index([tourId, createdAt])
  @@index([userId, createdAt])
}

model Media {
  id         String   @id @default(cuid())
  url        String   @unique
  pathname   String
  width      Int
  height     Int
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())
}
